# setup.sh fills the empty secrets with random values. Never commit .env.
DATA_ROOT=/srv/odoo20/data
ODOO_DB=odoo
# the URL people open, e.g. https://odoo.<your-tailnet>.ts.net after `tailscale serve`. setup.sh sets Odoo
# web.base.url to it and verifies through it. Leave empty until that URL answers.
PUBLIC_URL=
PG_PASSWORD=
ODOO_ADMIN_PASSWD=
DAGU_ADMIN_PASSWORD=
DAGU_TOKEN_SECRET=
ODOO_PORT=8069
KONG_PORT=8100
KONG_ADMIN_PORT=8101
DAGU_PORT=8092

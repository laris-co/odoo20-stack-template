# setup.sh fills the empty secrets with random values. Never commit .env.
DATA_ROOT=/srv/odoo20/data
ODOO_DB=odoo
# the URL people open (tailscale serve); setup.sh sets Odoo web.base.url to it and verifies through it
PUBLIC_URL=https://odoo.example.ts.net
PG_PASSWORD=
ODOO_ADMIN_PASSWD=
DAGU_ADMIN_PASSWORD=
DAGU_TOKEN_SECRET=
HOST_UID=1000
HOST_GID=1000
ODOO_PORT=8069
KONG_PORT=8100
KONG_ADMIN_PORT=8101
DAGU_PORT=8092
